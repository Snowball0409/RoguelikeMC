	"authors": [
		"snowball049"
	],
	"contact": {
		"homepage": "https://github.com/Snowball0409/RoguelikeMC/wiki",
		"sources": "https://github.com/Snowball0409/RoguelikeMC",
		"issues": "https://github.com/Snowball0409/RoguelikeMC/issues"
	},
	"license": "MIT",
	"icon": "assets/roguelikemc/icon.png",
